# Copia este archivo como .env.local y llena los valores.
# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon / publishable key>
# Secreta: solo vive en el servidor. Nunca en el frontend ni en Git.
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>


# Frontend que consume la API (enlaces de correos) y orígenes permitidos por CORS (separados por coma)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Cadena aleatoria de al menos 32 caracteres: firma los enlaces del tutor y anonimiza IPs.
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=<cadena-aleatoria-de-64-caracteres>

# Resend (correos al tutor). Sin llave, los correos se muestran en la consola.
RESEND_API_KEY=
MAIL_FROM=LexCode <no-reply@lexcode.app>
